    <rdfs:label xml:lang="en">AI systems intended to be used for risk assessment and pricing in relation to natural persons in the case of life and health insurance</rdfs:label>
    <prov:wasGeneratedBy rdf:resource="https://w3id.org/aiact-poc#run_7dfe75ab2f03"/>
