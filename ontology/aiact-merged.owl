    <aiact:obligationOf rdf:resource="https://w3id.org/aiact-poc#Deployer"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <prov:wasGeneratedBy rdf:resource="https://w3id.org/aiact-poc#run_7dfe75ab2f03"/>
    <aiact:articleRef>Art. 26(1)</aiact:articleRef>
    <aiact:hasLegalSource rdf:resource="http://data.europa.eu/eli/reg/2024/1689/art_26/oj"/>
    <aiact:sourceQuote>Deployers of high-risk AI systems shall take appropriate technical and organisational measures to ensure they use such systems in accordance with the instructions for use accompanying the systems, pursuant to paragraphs 3 and 6.</aiact:sourceQuote>
    <skos:definition xml:lang="en">Deployers of high-risk AI systems shall take appropriate technical and organisational measures to ensure they use such systems in accordance with the instructions for use accompanying the systems.</skos:definition>
  </aiact:Obligation>
