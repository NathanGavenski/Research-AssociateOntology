    <skos:definition xml:lang="en">AI systems that generate or manipulate image, audio or video content constituting a deep fake.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aiact-poc#AISystem"/>
    <aiact:sourceQuote>AI system that generates or manipulates image, audio or video content constituting a deep fake</aiact:sourceQuote>
    <prov:wasGeneratedBy rdf:resource="https://w3id.org/aiact-poc#run_7dfe75ab2f03"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/aiact-poc#AISystemsGeneratingSyntheticContent">
    <rdfs:subClassOf rdf:resource="https://w3id.org/aiact-poc#AISystem"/>
    <aiact:sourceQuote>generating synthetic audio, image, video or text content</aiact:sourceQuote>
    <aiact:curationStatus>accepted</aiact:curationStatus>
    <skos:definition xml:lang="en">AI systems that generate synthetic audio, image, video or text content.</skos:definition>
    <rdfs:label xml:lang="en">AI systems generating synthetic audio, image, video or text content</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
