aiact:PutInPlaceAQualityManagementSystem a owl:NamedIndividual,
        aiact:Obligation ;
    rdfs:label "put in place a quality management system"@en ;
    skos:definition "A documented system ensuring compliance with the Regulation, including strategies for regulatory compliance, design controls, data management, risk management, post-market monitoring, incident reporting, and accountability frameworks."@en ;
