    <aiact:obligationOf rdf:resource="https://w3id.org/aiact-poc#Provider"/>
    <rdfs:label xml:lang="en">when under their control, keep the logs automatically generated by their high-risk AI systems as referred to in Article 19</rdfs:label>
    <aiact:sourceQuote>when under their control, keep the logs automatically generated by their high-risk AI systems as referred to in Article 19</aiact:sourceQuote>
    <aiact:articleRef>Art. 16(e)</aiact:articleRef>
