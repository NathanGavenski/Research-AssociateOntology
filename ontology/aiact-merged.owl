  </owl:Class>
  <aiact:Obligation rdf:about="https://w3id.org/aiact-poc#ConsiderationOfAdverseImpactOnPersonsUnder18">
    <aiact:sourceQuote>providers shall give consideration to whether in view of its intended purpose the high-risk AI system is likely to have an adverse impact on persons under the age of 18 and, as appropriate, other vulnerable groups.</aiact:sourceQuote>
    <aiact:appliesToSystem rdf:resource="https://w3id.org/aiact-poc#HighRiskAISystem"/>
    <aiact:obligationOf rdf:resource="https://w3id.org/aiact-poc#Provider"/>
    <rdfs:label xml:lang="en">give consideration to whether in view of its intended purpose the high-risk AI system is likely to have an adverse impact on persons under the age of 18 and, as appropriate, other vulnerable groups.</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <prov:wasGeneratedBy rdf:resource="https://w3id.org/aiact-poc#run_7dfe75ab2f03"/>
    <aiact:hasLegalSource rdf:resource="http://data.europa.eu/eli/reg/2024/1689/art_9/oj"/>
    <skos:definition xml:lang="en">Providers shall give consideration to whether the high-risk AI system is likely to have an adverse impact on persons under the age of 18 and, as appropriate, other vulnerable groups.</skos:definition>
    <aiact:curationStatus>accepted</aiact:curationStatus>
    <aiact:articleRef>Art. 9(9)</aiact:articleRef>
  </aiact:Obligation>
  <owl:NamedIndividual rdf:about="https://w3id.org/aiact-poc#AccessToEssentialServicesAndBenefits">
    <skos:definition xml:lang="en">An area where AI systems are high-risk, covering eligibility for essential public assistance benefits and services, creditworthiness evaluation, risk assessment and pricing in life and health insurance, and the handling of emergency calls.</skos:definition>
    <rdf:type rdf:resource="https://w3id.org/aiact-poc#HighRiskArea"/>
    <aiact:hasLegalSource rdf:resource="http://data.europa.eu/eli/reg/2024/1689/anx_III/oj"/>
    <rdfs:label xml:lang="en">access to and enjoyment of essential private and public services and benefits</rdfs:label>
    <aiact:articleRef>Annex III(5)</aiact:articleRef>
    <prov:wasGeneratedBy rdf:resource="https://w3id.org/aiact-poc#run_7dfe75ab2f03"/>
    <aiact:sourceQuote>Access to and enjoyment of essential private services and essential public services and benefits:</aiact:sourceQuote>
    <aiact:curationStatus>edited</aiact:curationStatus>
  </owl:NamedIndividual>
  <aiact:Obligation rdf:about="https://w3id.org/aiact-poc#StopUseOnRejection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <prov:wasGeneratedBy rdf:resource="https://w3id.org/aiact-poc#run_7dfe75ab2f03"/>
    <aiact:obligationOf rdf:resource="https://w3id.org/aiact-poc#Deployer"/>
    <aiact:sourceQuote>If the authorisation requested pursuant to the first subparagraph is rejected, the use of the post-remote biometric identification system linked to that requested authorisation shall be stopped with immediate effect and the personal data linked to the use of the high-risk AI system for which the authorisation was requested shall be deleted.</aiact:sourceQuote>
    <skos:definition xml:lang="en">If the authorisation requested pursuant to the first subparagraph is rejected, the use of the post-remote biometric identification system linked to that requested authorisation shall be stopped with immediate effect and the personal data linked to the use of the high-risk AI system for which the authorisation was requested shall be deleted.</skos:definition>
    <aiact:articleRef>Art. 26(10)</aiact:articleRef>
    <aiact:curationStatus>edited</aiact:curationStatus>
    <aiact:hasLegalSource rdf:resource="http://data.europa.eu/eli/reg/2024/1689/art_26/oj"/>
    <aiact:appliesToSystem rdf:resource="https://w3id.org/aiact-poc#HighRiskAISystem"/>
    <rdfs:label xml:lang="en">stop with immediate effect and the personal data linked to the use of the high-risk AI system for which the authorisation was requested shall be deleted</rdfs:label>
  </aiact:Obligation>
  <owl:NamedIndividual rdf:about="https://w3id.org/aiact-poc#RiskManagementSystem">
    <prov:wasGeneratedBy rdf:resource="https://w3id.org/aiact-poc#run_7dfe75ab2f03"/>
    <aiact:sourceQuote>A risk management system shall be established, implemented, documented and maintained in relation to high-risk AI systems.</aiact:sourceQuote>
    <rdf:type rdf:resource="https://w3id.org/aiact-poc#Requirement"/>
    <aiact:articleRef>Art. 9(1)</aiact:articleRef>
    <rdfs:label xml:lang="en">risk management system</rdfs:label>
    <aiact:curationStatus>edited</aiact:curationStatus>
    <aiact:hasLegalSource rdf:resource="http://data.europa.eu/eli/reg/2024/1689/art_9/oj"/>
    <skos:definition xml:lang="en">A risk management system that must be established, implemented, documented and maintained in relation to high-risk AI systems.</skos:definition>
    <aiact:appliesToSystem rdf:resource="https://w3id.org/aiact-poc#HighRiskAISystem"/>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://w3id.org/aiact-poc#PolygraphSystems">
