  <owl:Class rdf:about="https://w3id.org/aiact-poc#RealTimeRemoteBiometricIdentificationSystem">
    <prov:wasGeneratedBy rdf:resource="https://w3id.org/aiact-poc#run_7dfe75ab2f03"/>
    <aiact:curationStatus>accepted</aiact:curationStatus>
    <aiact:sourceQuote>means a remote biometric identification system, whereby the capturing of biometric data, the comparison and the identification all occur without a significant delay, comprising not only instant identification, but also limited short delays in order to avoid circumvention;</aiact:sourceQuote>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aiact-poc#AISystem"/>
    <rdfs:label xml:lang="en">real-time remote biometric identification system</rdfs:label>
    <aiact:articleRef>Art. 3(42)</aiact:articleRef>
    <aiact:hasLegalSource>
      <aiact:LegalProvision rdf:about="http://data.europa.eu/eli/reg/2024/1689/art_3/oj">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="en">Art. 3</rdfs:label>
      </aiact:LegalProvision>
    </aiact:hasLegalSource>
    <skos:definition xml:lang="en">A remote biometric identification system, whereby the capturing of biometric data, the comparison and the identification all occur without a significant delay, comprising not only instant identification, but also limited short delays in order to avoid circumvention.</skos:definition>
  </owl:Class>
