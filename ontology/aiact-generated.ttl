    aiact:obligationOf aiact:Provider ;
    aiact:sourceQuote "measures identified and built, when technically feasible, into the high-risk AI system by the provider before it is placed on the market or put into service" .

aiact:CarryOutDataProtectionImpactAssessment a owl:NamedIndividual,
        aiact:Obligation ;
    rdfs:label "carry out a data protection impact assessment under Article 35 of Regulation (EU) 2016/679 or Article 27 of Directive (EU) 2016/680"@en ;
    skos:definition "Where applicable, deployers of high-risk AI systems shall use the information provided under Article 13 of this Regulation to comply with their obligation to carry out a data protection impact assessment under Article 35 of Regulation (EU) 2016/679 or Article 27 of Directive (EU) 2016/680."@en ;
    prov:wasGeneratedBy aiact:run_7dfe75ab2f03 ;
    aiact:appliesToSystem aiact:HighRiskAISystem ;
