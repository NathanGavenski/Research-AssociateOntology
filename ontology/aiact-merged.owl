  <owl:ObjectProperty rdf:about="https://w3id.org/aiact-poc#appliesToSystem">
    <rdfs:label xml:lang="en">applies to system</rdfs:label>
    <rdfs:domain>
      <owl:Class rdf:nodeID="nfcce62f63de34a6a9a12cb1077f45881b5">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://w3id.org/aiact-poc#Obligation"/>
