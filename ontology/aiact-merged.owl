    <owl:versionInfo>0.1.0</owl:versionInfo>
  </owl:Ontology>
  <owl:Class rdf:about="https://w3id.org/aiact-poc#MarketSurveillanceAuthority">
    <rdfs:label xml:lang="en">market surveillance authority</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aiact-poc#NationalCompetentAuthority"/>
    <aiact:articleRef>Art. 3(26)</aiact:articleRef>
    <aiact:curationStatus>hand-authored</aiact:curationStatus>
    <skos:definition xml:lang="en">The national authority carrying out market surveillance activities under the Act.</skos:definition>
