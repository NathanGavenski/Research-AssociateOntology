  <aiact:ProhibitedPractice rdf:about="https://w3id.org/aiact-poc#ExploitingVulnerabilities">
    <aiact:sourceQuote>an AI system that exploits any of the vulnerabilities of a natural person or a specific group of persons due to their age, disability or a specific social or economic situation</aiact:sourceQuote>
    <skos:definition xml:lang="en">An AI system that exploits any of the vulnerabilities of a natural person or a specific group of persons due to their age, disability or a specific social or economic situation, with the objective of materially distorting the behaviour of that person or a person belonging to that group.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
