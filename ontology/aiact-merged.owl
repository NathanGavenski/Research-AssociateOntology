  <owl:ObjectProperty rdf:about="https://w3id.org/aiact-poc#hasObligation">
    <rdfs:label xml:lang="en">has obligation</rdfs:label>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="https://w3id.org/aiact-poc#obligationOf">
        <rdfs:label xml:lang="en">obligation of</rdfs:label>
        <rdfs:domain rdf:resource="https://w3id.org/aiact-poc#Obligation"/>
        <rdfs:range>
          <owl:Class rdf:nodeID="nfcce62f63de34a6a9a12cb1077f45881b1">
            <owl:unionOf rdf:parseType="Collection">
              <rdf:Description rdf:about="https://w3id.org/aiact-poc#OperatorRole"/>
              <rdf:Description rdf:about="https://w3id.org/aiact-poc#Authority"/>
              <rdf:Description rdf:about="https://w3id.org/aiact-poc#MemberState"/>
            </owl:unionOf>
          </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">The range widens README §5.3 from OperatorRole to include Authority and MemberState, because the Act also places duties on the Commission, the AI Office, national authorities and the Member States.</rdfs:comment>
