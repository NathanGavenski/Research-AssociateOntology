  <aiact:Obligation rdf:about="https://w3id.org/aiact-poc#AppointmentOfAuthorisedRepresentative">
    <aiact:curationStatus>accepted</aiact:curationStatus>
    <aiact:appliesToSystem rdf:resource="https://w3id.org/aiact-poc#GeneralPurposeAIModel"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <aiact:obligationOf rdf:resource="https://w3id.org/aiact-poc#Provider"/>
    <aiact:articleRef>Art. 54(1)</aiact:articleRef>
    <aiact:sourceQuote>Prior to placing a general-purpose AI model on the Union market, providers established in third countries shall, by written mandate, appoint an authorised representative which is established in the Union.</aiact:sourceQuote>
    <skos:definition xml:lang="en">Providers established in third countries must, prior to placing a general-purpose AI model on the Union market, appoint an authorised representative by written mandate.</skos:definition>
    <prov:wasGeneratedBy rdf:resource="https://w3id.org/aiact-poc#run_7dfe75ab2f03"/>
    <aiact:hasLegalSource rdf:resource="http://data.europa.eu/eli/reg/2024/1689/art_54/oj"/>
    <rdfs:label xml:lang="en">appoint an authorised representative which is established in the Union</rdfs:label>
  </aiact:Obligation>
  <owl:NamedIndividual rdf:about="https://w3id.org/aiact-poc#LawEnforcement">
    <rdfs:label xml:lang="en">Law enforcement</rdfs:label>
