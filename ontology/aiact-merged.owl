  <owl:Class rdf:about="https://w3id.org/aiact-poc#GPAIModelWithSystemicRisk">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">general-purpose AI model with systemic risk</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aiact-poc#GeneralPurposeAIModel"/>
    <aiact:articleRef>Art. 51</aiact:articleRef>
    <aiact:articleRef>Art. 51(1)</aiact:articleRef>
    <aiact:articleRef>Art. 52(3)</aiact:articleRef>
    <aiact:curationStatus>hand-authored</aiact:curationStatus>
    <skos:definition xml:lang="en">A general-purpose AI model classified as having systemic risk under Article 51.</skos:definition>
    <prov:wasGeneratedBy rdf:resource="https://w3id.org/aiact-poc#run_7dfe75ab2f03"/>
    <aiact:sourceQuote>the general-purpose AI model shall be considered to be a general-purpose AI model with systemic risk</aiact:sourceQuote>
    <aiact:sourceQuote>A general-purpose AI model shall be classified as a general-purpose AI model with systemic risk if it meets any of the following conditions</aiact:sourceQuote>
    <aiact:hasLegalSource>
      <aiact:LegalProvision rdf:about="http://data.europa.eu/eli/reg/2024/1689/art_51/oj">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="en">Art. 51</rdfs:label>
      </aiact:LegalProvision>
    </aiact:hasLegalSource>
    <aiact:hasLegalSource rdf:resource="http://data.europa.eu/eli/reg/2024/1689/art_52/oj"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/aiact-poc#ProviderRole">
    <rdfs:label xml:lang="en">provider role</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aiact-poc#OperatorRole"/>
    <aiact:articleRef>Art. 3(3)</aiact:articleRef>
    <aiact:curationStatus>hand-authored</aiact:curationStatus>
    <skos:definition xml:lang="en">The role of developing an AI system or general-purpose AI model, or having one developed, and placing it on the market or putting it into service under one's own name or trademark.</skos:definition>
    <skos:closeMatch rdf:resource="https://w3id.org/airo#AIProvider"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/aiact-poc#Provider">
    <rdfs:label xml:lang="en">provider</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aiact-poc#OperatorRole"/>
    <owl:equivalentClass rdf:resource="https://w3id.org/aiact-poc#ProviderRole"/>
    <aiact:sourceQuote>means a natural or legal person, public authority, agency or other body that develops an AI system or a general-purpose AI model</aiact:sourceQuote>
    <aiact:articleRef>Art. 3(3)</aiact:articleRef>
    <aiact:hasLegalSource rdf:resource="http://data.europa.eu/eli/reg/2024/1689/art_3/oj"/>
    <prov:wasGeneratedBy rdf:resource="https://w3id.org/aiact-poc#run_7dfe75ab2f03"/>
    <aiact:curationStatus>accepted</aiact:curationStatus>
    <skos:definition xml:lang="en">A natural or legal person, public authority, agency or other body that develops an AI system or general-purpose AI model, or has one developed, and places it on the market or puts it into service under its own name or trademark.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/aiact-poc#Organisation">
    <rdfs:label xml:lang="en">organisation</rdfs:label>
    <aiact:curationStatus>hand-authored</aiact:curationStatus>
    <skos:definition xml:lang="en">A natural or legal person, public authority, agency or other body that can hold roles under the Act.</skos:definition>
    <skos:closeMatch rdf:resource="https://w3id.org/dpv#Organisation"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/aiact-poc#ProhibitedPractice">
    <rdfs:label xml:lang="en">prohibited practice</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aiact-poc#AIPractice"/>
    <aiact:articleRef>Art. 5</aiact:articleRef>
    <aiact:curationStatus>hand-authored</aiact:curationStatus>
    <skos:definition xml:lang="en">An AI practice prohibited by Article 5; its members are the individual practices listed there.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/aiact-poc#AuthorisedRepresentative">
    <aiact:sourceQuote>appoint an authorised representative which is established in the Union</aiact:sourceQuote>
    <aiact:sourceQuote>means a natural or legal person located or established in the Union who has received and accepted a written mandate from a provider of an AI system or a general-purpose AI model to, respectively, perform and carry out on its behalf the obligations and procedures established by this Regulation;</aiact:sourceQuote>
    <skos:definition xml:lang="en">A natural or legal person located or established in the Union who has received and accepted a written mandate from a provider of an AI system or a general-purpose AI model to, respectively, perform and carry out on its behalf the obligations and procedures established by this Regulation.</skos:definition>
    <aiact:hasLegalSource rdf:resource="http://data.europa.eu/eli/reg/2024/1689/art_3/oj"/>
    <aiact:hasLegalSource rdf:resource="http://data.europa.eu/eli/reg/2024/1689/art_54/oj"/>
    <prov:wasGeneratedBy rdf:resource="https://w3id.org/aiact-poc#run_7dfe75ab2f03"/>
    <aiact:articleRef>Art. 54(1)</aiact:articleRef>
    <aiact:articleRef>Art. 3(5)</aiact:articleRef>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aiact-poc#OperatorRole"/>
    <aiact:curationStatus>accepted</aiact:curationStatus>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:equivalentClass rdf:resource="https://w3id.org/aiact-poc#AuthorisedRepresentativeRole"/>
    <rdfs:label xml:lang="en">authorised representative</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/aiact-poc#MemberState">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Member State</rdfs:label>
    <aiact:articleRef>Art. 70</aiact:articleRef>
    <aiact:curationStatus>hand-authored</aiact:curationStatus>
    <skos:definition xml:lang="en">A Member State of the Union, which holds duties under the Act such as designating national competent authorities.</skos:definition>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://w3id.org/aiact-poc#AISystemsIntendedToInteractDirectlyWithNaturalPersons">
    <aiact:articleRef>Art. 50(1)</aiact:articleRef>
    <aiact:curationStatus>edited</aiact:curationStatus>
    <skos:definition xml:lang="en">AI systems intended to interact directly with natural persons.</skos:definition>
    <rdfs:label xml:lang="en">AI systems intended to interact directly with natural persons</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aiact-poc#AISystem"/>
    <prov:wasGeneratedBy rdf:resource="https://w3id.org/aiact-poc#run_7dfe75ab2f03"/>
    <aiact:sourceQuote>AI systems intended to interact directly with natural persons</aiact:sourceQuote>
    <aiact:hasLegalSource rdf:resource="http://data.europa.eu/eli/reg/2024/1689/art_50/oj"/>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://w3id.org/aiact-poc#MinimalRiskAISystem">
    <rdfs:label xml:lang="en">minimal-risk AI system</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aiact-poc#AISystem"/>
    <aiact:curationStatus>hand-authored</aiact:curationStatus>
    <skos:definition xml:lang="en">An AI system that is neither prohibited, high-risk nor subject to the transparency obligations.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/aiact-poc#ProhibitedAISystem">
    <rdfs:label xml:lang="en">prohibited AI system</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aiact-poc#AISystem"/>
    <aiact:articleRef>Art. 5</aiact:articleRef>
    <aiact:curationStatus>hand-authored</aiact:curationStatus>
    <skos:definition xml:lang="en">An AI system that puts a practice prohibited by Article 5 into effect.</skos:definition>
    <owl:disjointWith rdf:resource="https://w3id.org/aiact-poc#HighRiskAISystem"/>
    <owl:equivalentClass>
      <owl:Class rdf:nodeID="nfcce62f63de34a6a9a12cb1077f45881b13">
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://w3id.org/aiact-poc#AISystem"/>
          <owl:Restriction rdf:nodeID="nfcce62f63de34a6a9a12cb1077f45881b14">
            <owl:onProperty>
              <owl:ObjectProperty rdf:about="https://w3id.org/aiact-poc#usesPractice">
                <rdfs:label xml:lang="en">uses practice</rdfs:label>
                <rdfs:domain rdf:resource="https://w3id.org/aiact-poc#AISystem"/>
                <rdfs:range rdf:resource="https://w3id.org/aiact-poc#AIPractice"/>
                <skos:definition xml:lang="en">Relates an AI system to a practice it puts into effect.</skos:definition>
              </owl:ObjectProperty>
            </owl:onProperty>
            <owl:someValuesFrom rdf:resource="https://w3id.org/aiact-poc#ProhibitedPractice"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/aiact-poc#Requirement">
    <rdfs:label xml:lang="en">requirement</rdfs:label>
    <aiact:articleRef>Art. 8</aiact:articleRef>
    <aiact:curationStatus>hand-authored</aiact:curationStatus>
    <skos:definition xml:lang="en">A property a high-risk AI system must have under Section 2 of Chapter III; its members are the individual requirements.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/aiact-poc#DeployerRole">
    <rdfs:label xml:lang="en">deployer role</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aiact-poc#OperatorRole"/>
    <aiact:articleRef>Art. 3(4)</aiact:articleRef>
    <aiact:curationStatus>hand-authored</aiact:curationStatus>
    <skos:definition xml:lang="en">The role of using an AI system under one's own authority, other than in a personal non-professional activity.</skos:definition>
    <skos:closeMatch rdf:resource="https://w3id.org/airo#AIDeployer"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/aiact-poc#AISystem">
    <rdfs:label xml:lang="en">AI system</rdfs:label>
    <aiact:articleRef>Art. 3(1)</aiact:articleRef>
    <aiact:curationStatus>hand-authored</aiact:curationStatus>
    <skos:definition xml:lang="en">A machine-based system that infers, from the input it receives, how to generate outputs that can influence physical or virtual environments.</skos:definition>
    <skos:closeMatch rdf:resource="https://w3id.org/airo#AISystem"/>
    <aiact:hasLegalSource rdf:resource="http://data.europa.eu/eli/reg/2024/1689/art_3/oj"/>
    <prov:wasGeneratedBy rdf:resource="https://w3id.org/aiact-poc#run_7dfe75ab2f03"/>
    <aiact:sourceQuote>means a machine-based system that is designed to operate with varying levels of autonomy and that may exhibit adaptiveness after deployment, and that, for explicit or implicit objectives, infers, from the input it receives, how to generate outputs such as predictions, content, recommendations, or decisions that can influence physical or virtual environments;</aiact:sourceQuote>
  </owl:Class>
  <owl:Class rdf:about="http://data.europa.eu/eli/ontology#LegalResourceSubdivision"/>
  <owl:Class rdf:about="https://w3id.org/aiact-poc#ImporterRole">
    <rdfs:label xml:lang="en">importer role</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aiact-poc#OperatorRole"/>
    <aiact:articleRef>Art. 3(6)</aiact:articleRef>
    <aiact:curationStatus>hand-authored</aiact:curationStatus>
    <skos:definition xml:lang="en">The role of placing on the market an AI system bearing the name or trademark of a person established outside the Union.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/aiact-poc#Deployer">
    <aiact:sourceQuote>means a natural or legal person, public authority, agency or other body using an AI system under its authority except where the AI system is used in the course of a personal non-professional activity;</aiact:sourceQuote>
    <prov:wasGeneratedBy rdf:resource="https://w3id.org/aiact-poc#run_7dfe75ab2f03"/>
    <aiact:articleRef>Art. 3(4)</aiact:articleRef>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aiact-poc#OperatorRole"/>
    <rdfs:label xml:lang="en">deployer</rdfs:label>
    <aiact:curationStatus>accepted</aiact:curationStatus>
    <aiact:hasLegalSource rdf:resource="http://data.europa.eu/eli/reg/2024/1689/art_3/oj"/>
    <owl:equivalentClass rdf:resource="https://w3id.org/aiact-poc#DeployerRole"/>
    <skos:definition xml:lang="en">A natural or legal person, public authority, agency or other body using an AI system under its authority except where the AI system is used in the course of a personal non-professional activity.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/aiact-poc#LegalProvision">
    <rdfs:label xml:lang="en">legal provision</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/eli/ontology#LegalResourceSubdivision"/>
    <aiact:curationStatus>hand-authored</aiact:curationStatus>
    <skos:definition xml:lang="en">An article, paragraph or point of the Act, identified by its ELI URI.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/aiact-poc#AIPractice">
    <rdfs:label xml:lang="en">AI practice</rdfs:label>
    <aiact:curationStatus>hand-authored</aiact:curationStatus>
    <skos:definition xml:lang="en">A way of placing on the market, putting into service or using an AI system.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/aiact-poc#OperatorRole">
    <rdfs:label xml:lang="en">operator role</rdfs:label>
    <aiact:articleRef>Art. 3(8)</aiact:articleRef>
    <aiact:curationStatus>hand-authored</aiact:curationStatus>
    <skos:definition xml:lang="en">A role an organisation or person holds towards an AI system or model.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/aiact-poc#Authority">
    <rdfs:label xml:lang="en">authority</rdfs:label>
    <aiact:curationStatus>hand-authored</aiact:curationStatus>
    <skos:definition xml:lang="en">A public body with a function under the Act.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/aiact-poc#AuthorisedRepresentativeRole">
    <rdfs:label xml:lang="en">authorised representative role</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aiact-poc#OperatorRole"/>
    <aiact:articleRef>Art. 3(5)</aiact:articleRef>
    <aiact:curationStatus>hand-authored</aiact:curationStatus>
    <skos:definition xml:lang="en">The role of acting in the Union on a written mandate from a provider to carry out its obligations.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="http://www.w3.org/ns/prov#Activity"/>
</rdf:RDF>
