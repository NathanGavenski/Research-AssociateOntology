  </owl:AnnotationProperty>
  <owl:Class rdf:about="https://w3id.org/aiact-poc#LawEnforcementAuthority">
    <aiact:hasLegalSource rdf:resource="http://data.europa.eu/eli/reg/2024/1689/art_3/oj"/>
    <skos:definition xml:lang="en">Any public authority competent for the prevention, investigation, detection or prosecution of criminal offences or the execution of criminal penalties, including the safeguarding against and the prevention of threats to public security.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aiact-poc#Authority"/>
