  <aiact:Obligation rdf:about="https://w3id.org/aiact-poc#ProvisionOfInformation">
    <prov:wasGeneratedBy rdf:resource="https://w3id.org/aiact-poc#run_7dfe75ab2f03"/>
    <aiact:hasLegalSource rdf:resource="http://data.europa.eu/eli/reg/2024/1689/art_54/oj"/>
    <aiact:appliesToSystem rdf:resource="https://w3id.org/aiact-poc#GeneralPurposeAIModel"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <skos:definition xml:lang="en">The authorised representative shall provide the AI Office, upon a reasoned request, with all the information and documentation, including that referred to in point (b), necessary to demonstrate compliance with the obligations in this Chapter.</skos:definition>
    <aiact:obligationOf rdf:resource="https://w3id.org/aiact-poc#AuthorisedRepresentative"/>
    <rdfs:label xml:lang="en">provide the AI Office, upon a reasoned request, with all the information and documentation</rdfs:label>
    <aiact:sourceQuote>provide the AI Office, upon a reasoned request, with all the information and documentation, including that referred to in point (b), necessary to demonstrate compliance with the obligations in this Chapter;</aiact:sourceQuote>
    <aiact:curationStatus>edited</aiact:curationStatus>
    <aiact:articleRef>Art. 54(3)(c)</aiact:articleRef>
  </aiact:Obligation>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
  <owl:Class rdf:about="https://w3id.org/aiact-poc#AnnexIHighRiskAISystem">
    <rdfs:label xml:lang="en">Annex I high-risk AI system</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aiact-poc#HighRiskAISystem"/>
    <aiact:articleRef>Art. 6(1)</aiact:articleRef>
    <aiact:curationStatus>hand-authored</aiact:curationStatus>
    <skos:definition xml:lang="en">An AI system that is a safety component of a product covered by the Union harmonisation legislation in Annex I, or is itself such a product.</skos:definition>
  </owl:Class>
  <aiact:Obligation rdf:about="https://w3id.org/aiact-poc#RetentionOfTechnicalDocumentation">
    <aiact:appliesToSystem rdf:resource="https://w3id.org/aiact-poc#GeneralPurposeAIModel"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <prov:wasGeneratedBy rdf:resource="https://w3id.org/aiact-poc#run_7dfe75ab2f03"/>
    <aiact:obligationOf rdf:resource="https://w3id.org/aiact-poc#AuthorisedRepresentative"/>
    <rdfs:label xml:lang="en">keep a copy of the technical documentation specified in Annex XI at the disposal</rdfs:label>
    <aiact:articleRef>Art. 54(3)(b)</aiact:articleRef>
    <skos:definition xml:lang="en">The authorised representative shall keep a copy of the technical documentation specified in Annex XI at the disposal of the AI Office and national competent authorities, for a period of 10 years after the general-purpose AI model has been placed on the market.</skos:definition>
    <aiact:sourceQuote>keep a copy of the technical documentation specified in Annex XI at the disposal of the AI Office and national competent authorities, for a period of 10 years after the general-purpose AI model has been placed on the market</aiact:sourceQuote>
    <aiact:curationStatus>edited</aiact:curationStatus>
    <aiact:hasLegalSource rdf:resource="http://data.europa.eu/eli/reg/2024/1689/art_54/oj"/>
  </aiact:Obligation>
