    <skos:definition xml:lang="en">AI systems intended to be used to determine access or admission or to assign natural persons to educational and vocational training institutions.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aiact-poc#AISystem"/>
