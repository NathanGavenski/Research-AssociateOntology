aiact:ComplyWithRegistrationObligationsDeployer a owl:NamedIndividual,
        aiact:Obligation ;
    rdfs:label "comply with registration obligations"@en ;
    skos:definition "Deployers of high-risk AI systems that are public authorities, or Union institutions, bodies, offices or agencies shall comply with the registration obligations referred to in Article 49."@en ;
    prov:wasGeneratedBy aiact:run_7dfe75ab2f03 ;
    aiact:appliesToSystem aiact:HighRiskAISystem ;
