aiact:AccessToEssentialServicesAndBenefits a owl:NamedIndividual,
        aiact:HighRiskArea ;
    rdfs:label "access to and enjoyment of essential private and public services and benefits"@en ;
    skos:definition "An area where AI systems are high-risk, covering eligibility for essential public assistance benefits and services, creditworthiness evaluation, risk assessment and pricing in life and health insurance, and the handling of emergency calls."@en ;
    prov:wasGeneratedBy aiact:run_7dfe75ab2f03 ;
    aiact:articleRef "Annex III(5)" ;
    aiact:curationStatus "edited" ;
    aiact:hasLegalSource <http://data.europa.eu/eli/reg/2024/1689/anx_III/oj> ;
    aiact:sourceQuote "Access to and enjoyment of essential private services and essential public services and benefits:" .

aiact:Accuracy a owl:NamedIndividual,
        aiact:Requirement ;
    rdfs:label "accuracy"@en ;
    skos:definition "High-risk AI systems shall be designed and developed in such a way that they achieve an appropriate level of accuracy."@en ;
    prov:wasGeneratedBy aiact:run_7dfe75ab2f03 ;
    aiact:appliesToSystem aiact:HighRiskAISystem ;
    aiact:articleRef "Art. 15(1)" ;
    aiact:curationStatus "accepted" ;
    aiact:hasLegalSource <http://data.europa.eu/eli/reg/2024/1689/art_15/oj> ;
    aiact:sourceQuote "that they achieve an appropriate level of accuracy" .

aiact:AdministrationOfJusticeAndDemocraticProcesses a owl:NamedIndividual,
        aiact:HighRiskArea ;
    rdfs:label "Administration of justice and democratic processes"@en ;
    skos:definition "An area where AI systems are high-risk, covering assistance to judicial authorities in researching and interpreting the law, and influencing the outcome of elections, referenda or voting behaviour."@en ;
    prov:wasGeneratedBy aiact:run_7dfe75ab2f03 ;
    aiact:articleRef "Annex III(8)" ;
    aiact:curationStatus "edited" ;
    aiact:hasLegalSource <http://data.europa.eu/eli/reg/2024/1689/anx_III/oj> ;
    aiact:sourceQuote "Administration of justice and democratic processes:" .

aiact:AffixCEMarking a owl:NamedIndividual,
        aiact:Obligation ;
    rdfs:label "affix the CE marking to the high-risk AI system or, where that is not possible, on its packaging or its accompanying documentation, to indicate conformity with this Regulation, in accordance with Article 48"@en ;
    skos:definition "Providers must affix the CE marking to the system or packaging to indicate conformity."@en ;
    prov:wasGeneratedBy aiact:run_7dfe75ab2f03 ;
    aiact:appliesToSystem aiact:HighRiskAISystem ;
    aiact:articleRef "Art. 16(h)" ;
    aiact:curationStatus "accepted" ;
    aiact:hasLegalSource <http://data.europa.eu/eli/reg/2024/1689/art_16/oj> ;
    aiact:obligationOf aiact:Provider ;
    aiact:sourceQuote "affix the CE marking to the high-risk AI system or, where that is not possible, on its packaging or its accompanying documentation, to indicate conformity with this Regulation, in accordance with Article 48" .

aiact:AlternativeComplianceDemonstration a owl:NamedIndividual,
        aiact:Obligation ;
    rdfs:label "Providers of general-purpose AI models with systemic risks who do not adhere to an approved code of practice or do not comply with a European harmonised standard shall demonstrate alternative adequate means of compliance for assessment by the Commission"@en ;
    skos:definition "Providers of general-purpose AI models with systemic risks who do not adhere to an approved code of practice or do not comply with a European harmonised standard shall demonstrate alternative adequate means of compliance for assessment by the Commission."@en ;
    prov:wasGeneratedBy aiact:run_7dfe75ab2f03 ;
    aiact:appliesToSystem aiact:GPAIModelWithSystemicRisk ;
    aiact:articleRef "Art. 55(2)" ;
    aiact:curationStatus "edited" ;
    aiact:hasLegalSource <http://data.europa.eu/eli/reg/2024/1689/art_55/oj> ;
    aiact:obligationOf aiact:Provider ;
    aiact:sourceQuote "Providers of general-purpose AI models with systemic risks who do not adhere to an approved code of practice or do not comply with a European harmonised standard shall demonstrate alternative adequate means of compliance for assessment by the Commission" .

aiact:AppointmentOfAuthorisedRepresentative a owl:NamedIndividual,
        aiact:Obligation ;
    rdfs:label "appoint an authorised representative which is established in the Union"@en ;
    skos:definition "Providers established in third countries must, prior to placing a general-purpose AI model on the Union market, appoint an authorised representative by written mandate."@en ;
    prov:wasGeneratedBy aiact:run_7dfe75ab2f03 ;
    aiact:appliesToSystem aiact:GeneralPurposeAIModel ;
    aiact:articleRef "Art. 54(1)" ;
    aiact:curationStatus "accepted" ;
    aiact:hasLegalSource <http://data.europa.eu/eli/reg/2024/1689/art_54/oj> ;
    aiact:obligationOf aiact:Provider ;
    aiact:sourceQuote "Prior to placing a general-purpose AI model on the Union market, providers established in third countries shall, by written mandate, appoint an authorised representative which is established in the Union." .

aiact:AssignHumanOversight a owl:NamedIndividual,
        aiact:Obligation ;
    rdfs:label "assign human oversight to natural persons who have the necessary competence, training and authority"@en ;
    skos:definition "Deployers shall assign human oversight to natural persons who have the necessary competence, training and authority, as well as the necessary support."@en ;
    prov:wasGeneratedBy aiact:run_7dfe75ab2f03 ;
    aiact:appliesToSystem aiact:HighRiskAISystem ;
    aiact:articleRef "Art. 26(2)" ;
    aiact:curationStatus "edited" ;
    aiact:hasLegalSource <http://data.europa.eu/eli/reg/2024/1689/art_26/oj> ;
    aiact:obligationOf aiact:Deployer ;
    aiact:sourceQuote "Deployers shall assign human oversight to natural persons who have the necessary competence, training and authority, as well as the necessary support." .

aiact:AsylumApplicationExaminationSystems a owl:Class ;
    rdfs:label "AI systems intended to be used by or on behalf of competent public authorities or by Union institutions, bodies, offices or agencies to assist competent public authorities for the examination of applications for asylum, visa or residence permits and for associated complaints with regard to the eligibility of the natural persons applying for a status"@en ;
    rdfs:subClassOf aiact:AISystem ;
    skos:definition "AI systems intended to be used by or on behalf of competent public authorities or by Union institutions, bodies, offices or agencies to assist competent public authorities for the examination of applications for asylum, visa or residence permits and for associated complaints with regard to the eligibility of the natural persons applying for a status, including related assessments of the reliability of evidence."@en ;
    prov:wasGeneratedBy aiact:run_7dfe75ab2f03 ;
    aiact:articleRef "Annex III(7)(c)" ;
    aiact:curationStatus "accepted" ;
    aiact:hasLegalSource <http://data.europa.eu/eli/reg/2024/1689/anx_III/oj> ;
    aiact:sourceQuote "AI systems intended to be used by or on behalf of competent public authorities or by Union institutions, bodies, offices or agencies to assist competent public authorities for the examination of applications for asylum, visa or residence permits and for associated complaints with regard to the eligibility of the natural persons applying for a status, including related assessments of the reliability of evidence;" .

aiact:AutomaticRecordingOfEvents a owl:NamedIndividual,
        aiact:Requirement ;
    rdfs:label "automatic recording of events (logs)"@en ;
    skos:definition "High-risk AI systems must technically allow for the automatic recording of events over the lifetime of the system."@en ;
    prov:wasGeneratedBy aiact:run_7dfe75ab2f03 ;
    aiact:appliesToSystem aiact:HighRiskAISystem ;
    aiact:articleRef "Art. 12(1)" ;
    aiact:curationStatus "accepted" ;
    aiact:hasLegalSource <http://data.europa.eu/eli/reg/2024/1689/art_12/oj> ;
    aiact:sourceQuote "High-risk AI systems shall technically allow for the automatic recording of events (logs) over the lifetime of the system." .

aiact:BiasDetectionAndCorrection a owl:NamedIndividual,
        aiact:Requirement ;
    rdfs:label "bias detection and correction"@en ;
    skos:definition "Training, validation and testing data sets must be examined for biases likely to affect health and safety, have a negative impact on fundamental rights or lead to discrimination prohibited by Union law, and appropriate measures must be taken to detect, prevent and mitigate them."@en ;
    prov:wasGeneratedBy aiact:run_7dfe75ab2f03 ;
    aiact:appliesToSystem aiact:HighRiskAISystem ;
    aiact:articleRef "Art. 10(2)(f)",
        "Art. 10(2)(g)" ;
    aiact:curationStatus "edited" ;
    aiact:hasLegalSource <http://data.europa.eu/eli/reg/2024/1689/art_10/oj> ;
    aiact:sourceQuote "appropriate measures to detect, prevent and mitigate possible biases identified according to point (f)",
        "examination in view of possible biases that are likely to affect the health and safety of persons, have a negative impact on fundamental rights or lead to discrimination prohibited under Union law" .

aiact:BiometricCategorisation a owl:NamedIndividual,
        aiact:ProhibitedPractice ;
    rdfs:label "biometric categorisation systems that categorise individually natural persons based on their biometric data to deduce or infer their race, political opinions, trade union membership, religious or philosophical beliefs, sex life or sexual orientation"@en ;
    skos:definition "The placing on the market, putting into service for this specific purpose, or use of biometric categorisation systems that categorise individually natural persons based on their biometric data to deduce or infer their race, political opinions, trade union membership, religious or philosophical beliefs, sex life or sexual orientation."@en ;
    prov:wasGeneratedBy aiact:run_7dfe75ab2f03 ;
    aiact:articleRef "Art. 5(1)(g)" ;
    aiact:curationStatus "accepted" ;
    aiact:hasLegalSource <http://data.europa.eu/eli/reg/2024/1689/art_5/oj> ;
    aiact:sourceQuote "biometric categorisation systems that categorise individually natural persons based on their biometric data to deduce or infer their race, political opinions, trade union membership" .

aiact:BiometricCategorisationSystem a owl:Class ;
    rdfs:label "biometric categorisation system"@en ;
    rdfs:subClassOf aiact:AISystem ;
    skos:definition "An AI system for the purpose of assigning natural persons to specific categories on the basis of their biometric data, unless it is ancillary to another commercial service and strictly necessary for objective technical reasons."@en ;
    prov:wasGeneratedBy aiact:run_7dfe75ab2f03 ;
    aiact:articleRef "Annex III(1)(b)",
        "Art. 3(40)" ;
    aiact:curationStatus "accepted" ;
    aiact:hasLegalSource <http://data.europa.eu/eli/reg/2024/1689/anx_III/oj>,
        <http://data.europa.eu/eli/reg/2024/1689/art_3/oj> ;
    aiact:sourceQuote "AI systems intended to be used for biometric categorisation, according to sensitive or protected attributes or characteristics based on the inference of those attributes or characteristics;",
        "means an AI system for the purpose of assigning natural persons to specific categories on the basis of their biometric data, unless it is ancillary to another commercial service and strictly necessary for objective technical reasons;" .

aiact:Biometrics a owl:NamedIndividual,
        aiact:HighRiskArea ;
    rdfs:label "Biometrics"@en ;
    skos:definition "An area where AI systems are high-risk, specifically biometric systems whose use is permitted under relevant Union or national law."@en ;
    prov:wasGeneratedBy aiact:run_7dfe75ab2f03 ;
    aiact:articleRef "Annex III(1)" ;
    aiact:curationStatus "accepted" ;
    aiact:hasLegalSource <http://data.europa.eu/eli/reg/2024/1689/anx_III/oj> ;
    aiact:sourceQuote "Biometrics, in so far as their use is permitted under relevant Union or national law:" .

aiact:BuiltInOversightMeasures a owl:NamedIndividual,
        aiact:Obligation ;
    rdfs:label "measures identified and built... into the high-risk AI system"@en ;
    skos:definition "The provider shall identify and build measures into the high-risk AI system before it is placed on the market or put into service, when technically feasible."@en ;
