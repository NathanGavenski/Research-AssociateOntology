            <owl:onProperty>
              <owl:ObjectProperty rdf:about="https://w3id.org/aiact-poc#usedInArea">
                <rdfs:label xml:lang="en">used in area</rdfs:label>
                <rdfs:domain rdf:resource="https://w3id.org/aiact-poc#AISystem"/>
                <rdfs:range rdf:resource="https://w3id.org/aiact-poc#HighRiskArea"/>
