    </owl:equivalentClass>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://w3id.org/aiact-poc#DataGovernanceAndManagementPractices">
    <rdf:type rdf:resource="https://w3id.org/aiact-poc#Requirement"/>
    <skos:definition xml:lang="en">Training, validation and testing data sets must be subject to appropriate data governance and management practices for the intended purpose of the high-risk AI system.</skos:definition>
    <aiact:appliesToSystem rdf:resource="https://w3id.org/aiact-poc#HighRiskAISystem"/>
    <aiact:sourceQuote>Training, validation and testing data sets shall be subject to data governance and management practices appropriate for the intended purpose of the high-risk AI system.</aiact:sourceQuote>
    <aiact:hasLegalSource rdf:resource="http://data.europa.eu/eli/reg/2024/1689/art_10/oj"/>
    <rdfs:label xml:lang="en">data governance and management practices</rdfs:label>
    <aiact:articleRef>Art. 10(2)</aiact:articleRef>
    <prov:wasGeneratedBy rdf:resource="https://w3id.org/aiact-poc#run_7dfe75ab2f03"/>
    <aiact:curationStatus>edited</aiact:curationStatus>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://w3id.org/aiact-poc#supervisedBy">
    <rdfs:label xml:lang="en">supervised by</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/aiact-poc#AISystem"/>
    <rdfs:range rdf:resource="https://w3id.org/aiact-poc#Authority"/>
    <skos:definition xml:lang="en">Relates an AI system to an authority that supervises it.</skos:definition>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://w3id.org/aiact-poc#AdministrationOfJusticeAndDemocraticProcesses">
    <prov:wasGeneratedBy rdf:resource="https://w3id.org/aiact-poc#run_7dfe75ab2f03"/>
